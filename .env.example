# Environment Configuration
# Copy this file to .env and insert your OpenRouter API key.

APP_NAME="Enterprise Document Assistant"
ENVIRONMENT="development"
DEBUG=false

# LLM Provider: 'openrouter' (default), 'gemini', 'openai', or 'mock' (for offline CI tests)
LLM_PROVIDER="openrouter"

# OpenRouter API (Access any model: Llama 3.3, Claude, GPT-4o, DeepSeek)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Alternative: Google Gemini API (optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Alternative: OpenAI API (optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Retrieval & Confidence Gating Parameters
CONFIDENCE_THRESHOLD=0.35
ENABLE_RERANKER=true
TOP_K_FINAL=3
